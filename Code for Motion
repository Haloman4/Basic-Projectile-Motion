import sympy as sp

#Set terms and constants
t = sp.Symbol('t')
v = 100
theta = sp.pi/4
acceleration = -9.81
x0 = 0

# FUNction
def high_school_motion(velocity, angle, height, gravity):
  acceleration = gravity
  v_vector = sp.Matrix([velocity*sp.cos(angle), velocity*sp.sin(angle)])
  v_y0 = v_vector[1]
  x0 = height
  velocity = sp.integrate(acceleration, t) + v_v0
  position = sp.integrate(velocity, t) + x0
  landing = sp.solve(position)
  display(acceleration, velocity, position, landing)

#Call the function
#use: (velocity, angle, height, gravity)
high_school_motion(v, theta, x0, acceleration)

